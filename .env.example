# Backend configuration (local server or Vercel Functions)
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/attendly_attendance
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:5180,http://localhost:5173,http://localhost:4173,http://localhost:5180

# Optional frontend override. On Vercel the app uses the same-origin /api/attendance route.
# For local development, leave unset to use http://127.0.0.1:5001/api/attendance.
# VITE_API_URL=
